---
import { Image } from 'astro:assets';
import { bound } from '../data/bound';
import { img } from '../lib/images';
import Valknut from './Valknut.astro';

/**
 * The Bound.
 *
 * Each card leads with the character's finished render over a sponsor-tinted
 * ground, then the description, kit summary and the two abilities. No ultimates
 * are implied — every Bound carries exactly two.
 */
---

<ul role="list" class="roster">
  {
    bound.map((b, i) => {
      const render = img(b.render);
      return (
        <li class="roster__item reveal" style={`--reveal-delay:${i * 80}ms`}>
          <article
            class="bound"
            style={b.accent ? `--accent:${b.accent}` : undefined}
          >
            <div class="bound__stage">
              <span class="bound__glow" aria-hidden="true" />
              <span class="bound__watermark" aria-hidden="true"><Valknut weight={3} /></span>
              {render && (
                <Image
                  src={render}
                  alt={`${b.name}, ${b.sponsor} — full character render`}
                  widths={[320, 500, 760]}
                  sizes="(min-width: 1100px) 300px, (min-width: 700px) 34vw, 62vw"
                  loading="lazy"
                  decoding="async"
                  class="bound__render"
                />
              )}
              <span class="bound__ordinal" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>

            <div class="bound__body">
              <p class="bound__sponsor">
                <span class="bound__sigil"><Valknut weight={7} /></span>
                {b.sponsor}
              </p>

              <h3 class="display bound__name">{b.name}</h3>
              <p class="bound__desc">{b.description}</p>

              <dl class="bound__abilities">
                {b.abilities.map((a) => (
                  <div class="bound__ability">
                    <dt>{a.name}</dt>
                    <dd>{a.body}</dd>
                  </div>
                ))}
              </dl>

              <p class="bound__sponsor-note">{b.sponsorNote}</p>
            </div>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  .roster { display: grid; gap: var(--sp-5); }
  @media (min-width: 700px) { .roster { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1240px) { .roster { grid-template-columns: repeat(4, 1fr); gap: var(--sp-4); } }

  .bound {
    --accent: var(--c-gold-400);
    block-size: 100%;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--s-hairline);
    border-radius: var(--r-lg);
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--c-navy-800) 45%, transparent),
      color-mix(in oklab, var(--c-ink) 96%, transparent) 55%
    );
    transition: border-color var(--d-mid) var(--e-out), transform var(--d-mid) var(--e-out);
  }
  .bound:hover {
    border-color: color-mix(in oklab, var(--accent) 50%, transparent);
    transform: translateY(-4px);
  }
  @media (prefers-reduced-motion: reduce) { .bound:hover { transform: none; } }

  /* ---------------------------------------------------------------- stage */
  .bound__stage {
    position: relative;
    isolation: isolate;
    aspect-ratio: 3 / 4;
    display: grid;
    place-items: end center;
    overflow: hidden;
    border-block-end: 1px solid var(--s-hairline);
    background: radial-gradient(
      68% 52% at 50% 92%,
      color-mix(in oklab, var(--c-navy-700) 70%, transparent),
      var(--c-ink-raised) 72%
    );
  }

  /* Sponsor-tinted pool of light behind the figure. */
  .bound__glow {
    position: absolute;
    z-index: -2;
    inset-block-end: -14%;
    inset-inline-start: 50%;
    translate: -50% 0;
    inline-size: 116%;
    aspect-ratio: 1.5 / 1;
    background: radial-gradient(
      50% 50% at 50% 50%,
      color-mix(in oklab, var(--accent) 20%, transparent),
      transparent 70%
    );
  }

  .bound__watermark {
    position: absolute;
    z-index: -1;
    inset-block-start: 6%;
    inset-inline-start: 50%;
    translate: -50% 0;
    inline-size: 62%;
    color: color-mix(in oklab, var(--accent) 12%, transparent);
  }

  .bound__render {
    position: relative;
    inline-size: auto;
    max-inline-size: 88%;
    block-size: 94%;
    object-fit: contain;
    object-position: bottom center;
    filter: drop-shadow(0 12px 24px rgb(0 0 0 / 0.55));
    transition: transform var(--d-cine) var(--e-out);
  }
  .bound:hover .bound__render { transform: translateY(-2%) scale(1.03); }
  @media (prefers-reduced-motion: reduce) {
    .bound:hover .bound__render { transform: none; }
  }

  .bound__ordinal {
    position: absolute;
    inset-block-start: var(--sp-3);
    inset-inline-start: var(--sp-4);
    font-family: var(--f-display);
    font-size: var(--fs-sm);
    letter-spacing: var(--tr-label);
    color: color-mix(in oklab, var(--accent) 80%, white);
  }

  /* ----------------------------------------------------------------- body */
  .bound__body {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
    padding: var(--sp-5);
  }

  .bound__sponsor {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--accent);
  }
  .bound__sigil { inline-size: 0.9rem; flex: none; display: block; }

  .bound__name { font-size: var(--fs-lg); line-height: 1.1; }

  .bound__desc {
    font-size: var(--fs-sm);
    color: var(--t-secondary);
  }

  .bound__abilities {
    display: grid;
    gap: var(--sp-4);
    margin-block-start: var(--sp-2);
    padding-block-start: var(--sp-4);
    border-block-start: 1px solid var(--s-hairline);
  }
  .bound__ability dt {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    font-family: var(--f-display);
    font-size: var(--fs-base);
    text-transform: uppercase;
    letter-spacing: var(--tr-display);
    color: var(--t-primary);
    margin-block-end: var(--sp-2);
  }
  .bound__ability dt::before {
    content: '';
    inline-size: 0.6rem;
    block-size: 1px;
    background: var(--accent);
    flex: none;
    transform: translateY(-0.3em);
  }
  .bound__ability dd {
    margin: 0;
    padding-inline-start: calc(0.6rem + var(--sp-3));
    font-size: var(--fs-sm);
    color: var(--t-muted);
  }

  .bound__sponsor-note {
    margin-block-start: auto;
    padding-block-start: var(--sp-4);
    border-block-start: 1px solid var(--s-hairline);
    font-size: var(--fs-sm);
    font-style: italic;
    color: var(--t-muted);
  }
</style>
