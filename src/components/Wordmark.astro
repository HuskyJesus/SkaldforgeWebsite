---
/**
 * Skaldforge site logo.
 *
 * Uses the studio-supplied emblem artwork (public/assets/brand/skaldforge-emblem.png).
 * The source file is a flat, full-colour badge (gold valknut on a navy ground),
 * not a silhouette, so it is rendered as a plain image rather than masked with
 * currentColor the way the previous raven wordmark was.
 */
import { asset } from '../lib/url';

interface Props {
  class?: string;
  title?: string;
}
const { class: className, title } = Astro.props;
const src = asset('assets/brand/skaldforge-emblem.png');
---

<img
  src={src}
  alt={title ?? ''}
  role={title ? 'img' : 'presentation'}
  aria-hidden={title ? undefined : 'true'}
  class={className}
  width="184"
  height="184"
  decoding="async"
/>
