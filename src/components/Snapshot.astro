---
import { snapshot } from '../data/game';

interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const rows = compact ? snapshot.filter(r => ['Genre', 'Engine', 'Status'].includes(r.label)) : snapshot;

/** Scannable project facts. Verified fields only. no platforms, no dates. */
---

<dl class="snap reveal">
  {
    rows.map((row) => (
      <div class="snap__row">
        <dt>{row.label}</dt>
        <dd>{row.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .snap {
    display: grid;
    gap: 1px;
    background: var(--s-hairline);
    border: 1px solid var(--s-hairline);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  @media (min-width: 640px) { .snap { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .snap { grid-template-columns: repeat(3, 1fr); } }

  .snap__row {
    display: grid;
    gap: var(--sp-2);
    padding: var(--sp-5);
    background: color-mix(in oklab, var(--c-navy-900) 45%, var(--c-ink));
  }

  .snap__row dt {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--c-gold-500);
  }
  .snap__row dd {
    margin: 0;
    font-family: var(--f-body);
    font-size: var(--fs-lg);
    font-weight: 500;
    color: var(--t-primary);
    line-height: 1.2;
  }
</style>
