---
import Figure from './Figure.astro';

/**
 * Development view paired with the shipped result.
 * Two labelled figures side by side. the clearest way to show craft without
 * claiming anything the project has not actually done.
 */
interface Props {
  dev: { image: string; caption: string };
  final: { image: string; caption: string };
  devAlt?: string;
  finalAlt?: string;
  fit?: 'cover' | 'contain';
  resultLabel?: string;
}
const { dev, final, devAlt, finalAlt, fit = 'cover', resultLabel = 'Gameplay' } = Astro.props;
---

<div class="compare reveal">
  <div class="compare__side">
    <p class="compare__tag compare__tag--dev">Development</p>
    <Figure
      id={dev.image}
      alt={devAlt ?? dev.caption}
      caption={dev.caption}
      fit={fit}
      ratio="16 / 10"
      sizes="(min-width: 900px) 46vw, 100vw"
    />
  </div>

  <div class="compare__arrow" aria-hidden="true">
    <svg viewBox="0 0 24 8" focusable="false">
      <path d="M0 4h20M17 1l3 3-3 3" stroke="currentColor" stroke-width="1" fill="none" />
    </svg>
  </div>

  <div class="compare__side">
    <p class="compare__tag compare__tag--final">{resultLabel}</p>
    <Figure
      id={final.image}
      alt={finalAlt ?? final.caption}
      caption={final.caption}
      fit={fit}
      ratio="16 / 10"
      sizes="(min-width: 900px) 46vw, 100vw"
    />
  </div>
</div>

<style>
  .compare {
    display: grid;
    gap: var(--sp-5);
    align-items: start;
  }
  @media (min-width: 860px) {
    .compare {
      grid-template-columns: 1fr auto 1fr;
      gap: var(--sp-5);
      align-items: center;
    }
  }

  .compare__side { display: grid; gap: var(--sp-3); }

  .compare__tag {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }
  .compare__tag::before {
    content: '';
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-radius: 50%;
    flex: none;
  }
  .compare__tag--dev { color: var(--t-muted); }
  .compare__tag--dev::before { background: var(--c-steel-soft); }
  .compare__tag--final { color: var(--c-gold-300); }
  .compare__tag--final::before { background: var(--c-gold-400); }

  .compare__arrow {
    display: none;
    color: var(--c-gold-600);
    inline-size: 1.5rem;
  }
  @media (min-width: 860px) { .compare__arrow { display: block; } }
</style>
