---
import { Image } from 'astro:assets';
import { arenas } from '../data/game';
import { img } from '../lib/images';

/**
 * Arenas presented as destinations.
 *
 * Copy is deliberately thin: only Midgard's open character is substantiated as
 * current. No layout, verticality or chokepoint claims are made. those came
 * from older documentation and have not been verified against the current maps.
 */
---

<ul role="list" class="arenas">
  {
    arenas.map((arena, i) => {
      const source = img(arena.image);
      if (!source) return null;
      return (
        <li class="arena reveal" style={`--reveal-delay:${i * 90}ms`}>
          <article class="arena__card">
            <div class="arena__media">
              <Image
                src={source}
                alt={`${arena.name}, an arena in Mythbound`}
                widths={[420, 640, 900, 1200]}
                sizes="(min-width: 1000px) 420px, (min-width: 640px) 46vw, 92vw"
                loading="lazy"
                decoding="async"
                class="arena__img"
              />
              <div class="arena__scrim" aria-hidden="true" />
              <h3 class="display arena__name">{arena.name}</h3>
            </div>
            <p class="arena__blurb">{arena.blurb}</p>
          </article>
        </li>
      );
    })
  }
</ul>

<style>
  .arenas { display: grid; gap: var(--sp-5); }
  @media (min-width: 640px) { .arenas { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .arenas { grid-template-columns: repeat(3, 1fr); } }

  .arena__card {
    block-size: 100%;
    display: grid;
    grid-template-rows: auto 1fr;
    background: linear-gradient(
      180deg,
      color-mix(in oklab, var(--c-navy-900) 55%, transparent),
      color-mix(in oklab, var(--c-ink) 92%, transparent)
    );
    border: 1px solid var(--s-hairline);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: border-color var(--d-mid) var(--e-out), transform var(--d-mid) var(--e-out);
  }
  .arena:hover .arena__card {
    border-color: var(--s-hairline-lit);
    transform: translateY(-3px);
  }
  @media (prefers-reduced-motion: reduce) {
    .arena:hover .arena__card { transform: none; }
  }

  .arena__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .arena__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform var(--d-cine) var(--e-out);
  }
  .arena:hover .arena__img { transform: scale(1.05); }
  @media (prefers-reduced-motion: reduce) {
    .arena:hover .arena__img { transform: none; }
  }

  .arena__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklab, var(--c-ink) 92%, transparent) 0%,
      transparent 60%
    );
  }

  /* Name sits on the image so the card below stays quiet. */
  .arena__name {
    position: absolute;
    inset-block-end: var(--sp-4);
    inset-inline-start: var(--sp-5);
    font-size: var(--fs-h3);
    text-shadow: 0 2px 16px rgb(0 0 0 / 0.7);
  }

  .arena__blurb {
    padding: var(--sp-5);
    font-size: var(--fs-sm);
    color: var(--t-secondary);
  }
</style>
