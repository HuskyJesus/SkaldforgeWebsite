---
import { asset } from '../lib/url';

/** Use the supplied artwork as an alpha mask, retaining each wrapper's color. */
interface Props {
  title?: string;
}
const { title } = Astro.props;
const image = asset('assets/brand/valknut.png');
// Keep the essential paint and dimensions on the element: a stale stylesheet
// from the previous SVG implementation must not collapse this empty span.
const mask = `url("${image}") center / contain no-repeat`;
---

<span
  class="valknut"
  style={{
    display: 'block',
    width: '100%',
    height: 'auto',
    aspectRatio: '1 / 1',
    backgroundColor: 'currentColor',
    WebkitMask: mask,
    mask,
    maskMode: 'alpha',
  }}
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
></span>
