---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { contact } from '../data/site';
---

<Base
  title="Contact"
  description="Get in touch with Skaldforge, the studio building Mythbound."
  navOverlay
>
  <Hero
    variant="still"
    stillId="helheim"
    size="tall"
    eyebrow="Get in touch"
    heading="Contact"
    statement="Questions, press or partnership enquiries. We read everything that comes in."
  />

  <section class="section section--tight" aria-labelledby="contact-title">
    <div class="wrap wrap--wide contact-page">
      <div class="contact-page__text reveal">
        <SectionHeading
          id="contact-title"
          eyebrow="Contact"
          title="Send us a message"
          lede="Fill out the form and it opens a message in your email app, addressed to our team."
        />
        {contact.email && (
          <p class="contact-page__direct">
            Prefer to write directly? <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </p>
        )}
      </div>

      <form class="contact-form reveal" id="contact-form" novalidate>
        <div class="contact-form__field">
          <label for="contact-name">Name</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required />
        </div>

        <div class="contact-form__field">
          <label for="contact-email">Your email</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required />
        </div>

        <div class="contact-form__field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="6" required></textarea>
        </div>

        <button class="btn btn--primary" type="submit">Send message</button>
        <p class="contact-form__note" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>
</Base>

<script define:vars={{ studioEmail: contact.email }} is:inline>
  const form = document.getElementById('contact-form');
  const note = form?.querySelector('.contact-form__note');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!studioEmail) return;

    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();

    const subject = `Message from ${name || 'the Mythbound site'}`;
    const body = `${message}\n\n— ${name} (${email})`;
    const mailto = `mailto:${studioEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

    window.location.href = mailto;
    if (note) note.textContent = 'Opening your email app to send this message…';
  });
</script>

<style>
  .contact-page {
    display: grid;
    gap: var(--sp-8);
  }
  @media (min-width: 900px) {
    .contact-page {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(var(--sp-7), 6vw, var(--sp-9));
      align-items: start;
    }
  }
  .contact-page__direct {
    margin-block-start: var(--sp-5);
    color: var(--t-secondary);
  }
  .contact-page__direct a { color: var(--c-gold-300); }

  .contact-form {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }
  .contact-form__field {
    display: grid;
    gap: var(--sp-2);
  }
  .contact-form__field label {
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--tr-eyebrow);
    text-transform: uppercase;
    color: var(--t-muted);
  }
  .contact-form__field input,
  .contact-form__field textarea {
    border: 1px solid var(--s-hairline);
    border-radius: var(--r-md, var(--r-lg));
    background: color-mix(in oklab, var(--c-navy-900) 40%, var(--c-ink));
    color: var(--t-primary);
    padding: var(--sp-3) var(--sp-4);
    font-size: var(--fs-base);
    resize: vertical;
  }
  .contact-form__note {
    min-height: 1.2em;
    font-size: var(--fs-sm);
    color: var(--c-gold-300);
  }
</style>
