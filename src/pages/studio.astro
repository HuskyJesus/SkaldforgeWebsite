---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Figure from '../components/Figure.astro';
import CTA from '../components/CTA.astro';
import Valknut from '../components/Valknut.astro';

import { studio, publishRoster, leadership, team } from '../data/studio';
import { game } from '../data/game';
import { contact, socials } from '../data/site';
import { url } from '../lib/url';

const roster = publishRoster ? [...leadership, ...team] : [];
---

<Base
  title="Studio"
  description="Skaldforge is a multidisciplinary game studio building Mythbound, a competitive Norse arena brawler in Unreal Engine."
  navOverlay
>
  <Hero
    variant="still"
    stillId="midgard-set-dressing"
    size="tall"
    eyebrow="The Studio"
    heading="We are Skaldforge"
    statement={studio.statement}
  />

  {/* ------------------------------------------------------------ statement */}
  <section class="section" aria-labelledby="statement-title">
    <div class="wrap wrap--wide">
      <div class="statement reveal">
        <h2 id="statement-title" class="display statement__title">
          A small team building one ambitious game.
        </h2>
        <div class="statement__copy">
          <p>{studio.lede}</p>
          <p>
            We are not trying to sound bigger than we are. What we have is a real playable game,
            a clear idea of what it should feel like, and a team that covers every discipline it
            takes to build it.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- philosophy */}
  <section class="section section--tight philosophy" aria-labelledby="philosophy-title">
    <div class="wrap wrap--wide">
      <SectionHeading
        eyebrow="How we work"
        title="Three things we hold to"
        class="philosophy__head"
      />
      <ul role="list" class="philosophy__list">
        {
          studio.philosophy.map((p, i) => (
            <li class="philosophy__item reveal" style={`--reveal-delay:${i * 80}ms`}>
              <span class="philosophy__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="philosophy__title">{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ------------------------------------------------------ current project */}
  <section class="section project" aria-labelledby="project-title">
    <div class="wrap wrap--wide">
      <div class="project__grid">
        <div class="project__text reveal">
          <p class="eyebrow">Current project</p>
          <h2 id="project-title" class="display project__title">Mythbound</h2>
          <p class="project__body">
            A {game.genre.toLowerCase()} built in {game.engine}. Four Bound, contracted to the old
            gods, fight over an ancient relic in arenas designed to reward speed. In development
            toward {game.releaseWindow}.
          </p>
          <div class="project__actions">
            <a class="btn btn--primary" href={url('/mythbound')}>Discover Mythbound</a>
            <a class="btn btn--ghost" href={url('/technology')}>How it's built</a>
          </div>
        </div>
        <div class="project__media reveal">
          <Figure
            id="midgard-aerial"
            alt="Aerial view of the Midgard arena — a timber village ringed by pine forest and mountain cliffs."
            ratio="16 / 10"
            sizes="(min-width: 1000px) 620px, 100vw"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- disciplines */}
  <section class="section section--tight" aria-labelledby="disciplines-title">
    <div class="wrap wrap--wide">
      <SectionHeading
        eyebrow="Multidisciplinary"
        title="Every discipline in one room"
        lede="Design, art, animation, technical art and engineering work against the same build, in the same week."
        class="disciplines__head"
      />
      <ul role="list" class="disciplines reveal">
        {studio.disciplines.map((d) => <li>{d}</li>)}
      </ul>
    </div>
  </section>

  {/* --------------------------------------------------------------- origin */}
  {
    studio.origin.show && (
      <section class="section origin" aria-labelledby="origin-title">
        <div class="wrap wrap--wide">
          <div class="origin__inner reveal">
            <span class="origin__mark"><Valknut /></span>
            <h2 id="origin-title" class="display origin__title">{studio.origin.title}</h2>
            <p class="origin__body">{studio.origin.body}</p>
          </div>
        </div>
      </section>
    )
  }

  {/* ----------------------------------------------------------------- team */}
  {
    publishRoster && roster.length > 0 && (
      <section class="section section--tight" aria-labelledby="team-title">
        <div class="wrap wrap--wide">
          <SectionHeading eyebrow="The team" title="Who builds it" class="team__head" />
          <ul role="list" class="team">
            {roster.map((m) => (
              <li class="team__member reveal">
                <p class="team__name">{m.name}</p>
                <p class="team__role">{m.role}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {/* -------------------------------------------------------------- contact */}
  {
    (contact.email || socials.length > 0) && (
      <section class="section section--tight" aria-labelledby="contact-title">
        <div class="wrap wrap--wide">
          <SectionHeading eyebrow="Contact" title="Get in touch" align="center" />
          <div class="contact reveal">
            {contact.email && (
              <a class="btn btn--primary" href={`mailto:${contact.email}`}>
                {contact.email}
              </a>
            )}
            {socials.map((s) => (
              <a class="btn btn--ghost" href={s.href} rel="me noopener">
                {s.label}
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CTA
    lockup
    eyebrow={`In development — ${game.releaseWindow}`}
    body="Mythbound is the first game from Skaldforge."
    primary={{ label: 'Discover Mythbound', href: url('/mythbound') }}
    secondary={{ label: 'Development', href: url('/technology') }}
  />
</Base>

<style>
  .statement { display: grid; gap: var(--sp-6); }
  @media (min-width: 900px) {
    .statement {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(var(--sp-7), 6vw, var(--sp-9));
      align-items: start;
    }
  }
  .statement__title { font-size: var(--fs-h2); max-width: 16ch; }
  .statement__copy { display: grid; gap: var(--sp-4); color: var(--t-secondary); font-size: var(--fs-lg); }

  /* ----------------------------------------------------------- philosophy */
  .philosophy { border-block-start: 1px solid var(--s-hairline); }
  .philosophy__head { margin-block-end: var(--sp-8); }
  .philosophy__list { display: grid; gap: var(--sp-5); }
  @media (min-width: 800px) { .philosophy__list { grid-template-columns: repeat(3, 1fr); } }

  .philosophy__item {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    padding-block-start: var(--sp-5);
    border-block-start: 1px solid var(--s-hairline);
  }
  .philosophy__num {
    font-family: var(--f-display);
    font-size: var(--fs-sm);
    color: var(--c-gold-500);
    letter-spacing: var(--tr-label);
  }
  .philosophy__title {
    font-family: var(--f-display);
    font-size: var(--fs-h3);
    text-transform: uppercase;
    letter-spacing: var(--tr-display);
  }
  .philosophy__item p { color: var(--t-secondary); }

  /* -------------------------------------------------------------- project */
  .project {
    border-block-start: 1px solid var(--s-hairline);
    background: radial-gradient(70% 60% at 80% 0%, color-mix(in oklab, var(--c-navy-800) 45%, transparent), transparent 70%);
  }
  .project__grid { display: grid; gap: var(--sp-7); align-items: center; }
  @media (min-width: 1000px) {
    .project__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: clamp(var(--sp-7), 6vw, var(--sp-9));
    }
  }
  .project__text { display: grid; gap: var(--sp-4); align-content: start; }
  .project__title { font-size: var(--fs-h1); }
  .project__body { color: var(--t-secondary); max-width: 46ch; font-size: var(--fs-lg); }
  .project__actions { display: flex; flex-wrap: wrap; gap: var(--sp-3); margin-block-start: var(--sp-2); }

  /* ---------------------------------------------------------- disciplines */
  .disciplines__head { margin-block-end: var(--sp-6); }
  .disciplines {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .disciplines li {
    font-family: var(--f-display);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: var(--tr-display);
    color: var(--t-secondary);
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--s-hairline);
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--c-navy-900) 35%, transparent);
  }

  /* --------------------------------------------------------------- origin */
  .origin { border-block-start: 1px solid var(--s-hairline); }
  .origin__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--sp-4);
  }
  .origin__mark { display: block; inline-size: 2.25rem; color: var(--c-gold-500); }
  .origin__title { font-size: var(--fs-h2); }
  .origin__body { color: var(--t-secondary); max-width: 60ch; font-size: var(--fs-lg); }

  /* ----------------------------------------------------------------- team */
  .team__head { margin-block-end: var(--sp-7); }
  .team {
    display: grid;
    gap: 1px;
    background: var(--s-hairline);
    border: 1px solid var(--s-hairline);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  @media (min-width: 560px) { .team { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) { .team { grid-template-columns: repeat(3, 1fr); } }
  .team__member {
    padding: var(--sp-5);
    background: color-mix(in oklab, var(--c-navy-900) 40%, var(--c-ink));
  }
  .team__name { font-size: var(--fs-base); color: var(--t-primary); }
  .team__role {
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--t-muted);
    margin-block-start: var(--sp-1);
  }

  /* -------------------------------------------------------------- contact */
  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--sp-3);
    margin-block-start: var(--sp-6);
  }
</style>
