---
import Base from '../layouts/Base.astro';
import Valknut from '../components/Valknut.astro';
import { url } from '../lib/url';
---

<Base title="Page not found" description="That page does not exist.">
  <section class="nf">
    <div class="wrap nf__inner">
      <span class="nf__mark"><Valknut /></span>
      <p class="eyebrow eyebrow--center">404</p>
      <h1 class="display nf__title">This path leads nowhere</h1>
      <p class="nf__body">The page you were looking for is not here.</p>
      <div class="nf__actions">
        <a class="btn btn--primary" href={url('/')}>Return home</a>
        <a class="btn btn--ghost" href={url('/mythbound')}>Discover Mythbound</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-block-size: 72svh;
    display: grid;
    place-items: center;
    padding-block: var(--sp-9) var(--sp-8);
    padding-block-start: calc(var(--nav-h) + var(--sp-9));
  }
  .nf__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--sp-4);
  }
  .nf__mark { display: block; inline-size: 2.75rem; color: var(--c-gold-500); }
  .nf__title { font-size: var(--fs-h1); }
  .nf__body { color: var(--t-secondary); font-size: var(--fs-lg); }
  .nf__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--sp-3); margin-block-start: var(--sp-3); }
</style>
